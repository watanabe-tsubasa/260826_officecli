{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "officecli": {
      "type": "local",
      "command": [
        "./node_modules/.bin/officecli",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "OFFICECLI_SKIP_UPDATE": "1"
      }
    }
  },

  "permission": {
    "*": "deny",
    "officecli_*": "allow"
  }
}
